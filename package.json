{
  "name": "crunchy-bananas",
  "private": true,
  "scripts": {
    "before-after:test": "node scripts/verify-before-after.mjs",
    "demos:test": "node scripts/verify-demos.mjs",
    "lint:fix": "pnpm run --filter '*' lint:fix",
    "lint": "pnpm run --filter '*' lint",
    "build": "pnpm run --filter './apps/*' build",
    "dev": "pnpm run --filter './apps/*' dev",
    "realm:lint": "eslint docs/realm/js/*.js --no-config-lookup --rule '{\"no-unused-vars\":[\"error\",{\"argsIgnorePattern\":\"^_\",\"varsIgnorePattern\":\"^_\",\"caughtErrors\":\"none\"}],\"no-unreachable\":\"error\",\"no-constant-condition\":\"error\"}'",
    "realm:test": "node docs/realm/scripts/verify-realm.mjs",
    "realm:check": "pnpm realm:lint && pnpm realm:test"
  },
  "peerDependencyRules": {
    "allowAny": [
      "typescript",
      "ember-source"
    ]
  },
  "resolutions": {
    "ember-source": "catalog:",
    "@glint/template": "catalog:glint",
    "@babel/core": "catalog:",
    "ember-cli-babel": "^8.2.0"
  },
  "packageManager": "pnpm@9.12.2",
  "dependencies": {
    "@ember/app-tsconfig": "catalog:",
    "@embroider/addon-dev": "8.1.0",
    "@glint/ember-tsc": "catalog:glint",
    "@glint/template": "catalog:glint",
    "@glint/tsserver-plugin": "catalog:glint"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "ember-eslint-parser": "^0.5.13"
  }
}
