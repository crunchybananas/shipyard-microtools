# Dependencies
node_modules/
apps/*/node_modules/

# Build outputs
dist/
.vite/
tmp/
.tmp/
apps/*/tmp/

# Ember
.ember-cli
.env*

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Built Ember apps (regenerated on CI)
docs/ember/*/
!docs/ember/.gitkeep
docs/morphogen/
.eslintcache

# Realm sprite tooling virtualenv (docs/realm/assets/sprites/README.md)
docs/realm/scripts/.venv/
firebase/node_modules/

# the Firebase CLI's per-deploy upload cache — a local artifact that changes
# every time anyone deploys, so tracking it means every status is dirty
.firebase/

# Throwaway capture/probe harnesses copied into the repo root so they can resolve
# node_modules. They are scratch, never deliverables — one slipped into a commit
# via `git add -A` before this rule existed.
*.tmp.mjs
